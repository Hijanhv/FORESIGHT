# ── TxLINE ───────────────────────────────────────────────────────────────────
# Auth host — guest/start and token/activate endpoints live here.
# Same URL for both devnet and mainnet.
TXLINE_AUTH_URL=https://txline.txodds.com

# Data API host — odds and scores SSE streams (same host as auth).
TXLINE_API_URL=https://txline.txodds.com/api

# ── Solana ────────────────────────────────────────────────────────────────────
# Cluster: devnet | mainnet-beta
# DevNet:  program 6pW64gN1s2uqjHkn1unFeEjAwJkPGHoppGvS715wyP2J, mint GYdh...
# MainNet: program 9ExbZjAapQww1vfcisDmrngPinHTEfpjYRWMunJgcKaA, mint sLX1...
SOLANA_CLUSTER=mainnet-beta
SOLANA_RPC=https://api.mainnet-beta.solana.com

# Path to the Solana keypair JSON (secret-key byte array).
# NEVER commit this file. Generate with: solana-keygen new -o app-key.json
# On mainnet the wallet needs ~0.001 SOL for gas (buy from any exchange).
# On devnet SOL is airdropped automatically.
WALLET_KEYPAIR_PATH=./app-key.json
